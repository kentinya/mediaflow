        {"providerId": "1", "title": "The Matrix Resurrections", "year": 2021},
        {"providerId": "603", "title": "The Matrix", "year": 1999}
      ],
      "expect": {"matchStatus": "matched", "selectedProviderId": "603"}
    },
    {
      "name": "low-confidence",
      "path": "/A/The.Matrix.1999.mkv",
      "candidates": [{"providerId": "9", "title": "Completely Different", "year": 1970}],
      "expect": {"matchStatus": "not_found", "selectedProviderId": null}
