{
  "cases": [
    {
      "name": "recognition-a",
      "path": "/A/The.Matrix.1999.mkv",
      "expect": {"recognitionType": "A", "metadataPolicy": "A", "namingPolicy": "A"}
    },
    {
      "name": "recognition-b",
      "path": "/B/Show.2020.S01E01.mkv",
      "expect": {"recognitionType": "B", "metadataPolicy": "B", "classificationPolicy": "B"}
    },
    {
      "name": "recognition-c-policy-reuse",
      "path": "/C/The.Matrix.1999.mkv",
      "expect": {
        "recognitionType": "C",
        "metadataPolicy": "C",
        "namingPolicy": "A",
        "classificationPolicy": "A",
        "organizePolicy": "A",
        "recognitionTypePreserved": true
      }
    },
    {
      "name": "movie-exact-metadata",
      "path": "/A/The.Matrix.1999.mkv",
      "candidates": [{"providerId": "603", "title": "The Matrix", "year": 1999}],
      "expect": {
        "matchStatus": "matched",
        "selectedProviderId": "603",
        "naming": {
          "directory": "The Matrix (1999)",
          "directorySegments": ["The Matrix (1999)"],
          "filename": "The Matrix (1999).mkv"
        }
      }
    },
    {
      "name": "wrong-first-correct-later",
      "path": "/A/The.Matrix.1999.mkv",
