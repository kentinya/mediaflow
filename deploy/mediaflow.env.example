# Deployment-owned environment file for the MediaFlow Compose stack.
# Copy this file to .env.mediaflow (or set MEDIAFLOW_ENV_FILE), replace the
# placeholder value, and keep the file outside Git.
#
# The container runs as UID/GID 10001 by default, so the mounted file must be
# readable (and not writable) by that UID/GID on the host.

MEDIAFLOW_API_TOKEN=replace-with-a-long-random-bearer-token

# Optional deployment-owned references consumed only when enabled in the
# runtime configuration:
# TMDB_ACCESS_TOKEN=replace-with-a-tmdb-token
# MEDIAFLOW_WEBHOOK_SECRET=replace-with-an-independent-webhook-secret
